# ==============================================================================
# BioCloud Workbench Configuration Template
# ==============================================================================

# Core Application Mode
# Set to 'true' for local development (SQLite, local disk, local async workers, local JWT)
# Set to 'false' for production AWS mode (Aurora PostgreSQL, S3 KMS, SQS FIFO, Cognito)
LOCAL_DEV_MODE=true
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Connection
# Local: sqlite:///./data/biocloud.db
# AWS Production: postgresql://biocloud_admin:YOUR_DB_PASSWORD@biocloud-cluster.cluster-xyz.us-east-1.rds.amazonaws.com:5432/biocloud
DATABASE_URL=sqlite:///./data/biocloud.db

# Storage Adapter: 'local' or 's3'
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./data/storage

# Queue Adapter: 'local' or 'sqs'
QUEUE_TYPE=local

# Local JWT Authentication (Used when LOCAL_DEV_MODE=true)
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# AWS Production Settings (Required when LOCAL_DEV_MODE=false)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=biocloud-workbench-data-123456789012-us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789abc

# Amazon Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_AbCdEfG12
COGNITO_CLIENT_ID=1234567890abcdefghijklmnop
COGNITO_REGION=us-east-1

# Amazon SQS FIFO Queues (Dedicated queues for ECG DSP and Protein Folding)
SQS_ECG_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/biocloud-workbench-ecg-queue.fifo
SQS_PROTEIN_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/biocloud-workbench-protein-queue.fifo

# AWS Batch GPU for Protein Structure Prediction (ESMFold)
BATCH_PROTEIN_ENABLED=false
BATCH_PROTEIN_JOB_QUEUE=arn:aws:batch:us-east-1:123456789012:job-queue/biocloud-workbench-protein-batch-queue
BATCH_PROTEIN_JOB_DEFINITION=arn:aws:batch:us-east-1:123456789012:job-definition/esmfold-gpu-worker:1

# ------------------------------------------------------------------------------
# ESMFold / AlphaFold ML Model Configuration
# ------------------------------------------------------------------------------
# Enable if NVIDIA GPU and ESMFold weights are downloaded locally or on AWS Batch
ESMFOLD_MODEL_ENABLED=false
ESMFOLD_DEVICE=cuda:0
ESMFOLD_WEIGHTS_PATH=./models/esmfold_v1
ESMFOLD_MAX_RESIDUES=400
# Optional remote endpoint for ESMFold inference cluster
ESMFOLD_API_ENDPOINT=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
